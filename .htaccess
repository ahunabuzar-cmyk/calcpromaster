<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve existing files/dirs directly (never rewrite them)
  RewriteRule ^index\.html$ - [L]
  # Soft-404 fix: real asset requests (.js/.css/.png/...) that don't exist → Apache 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|svg|ico|xml|txt|json|webmanifest|woff2?)$
  RewriteRule . - [R=404,L]
  # Whitelisted extensionless route prefixes → SPA index.html with 200.
  # MUST mirror scripts/route-whitelist.cjs (20 categories + hub/compare/
  # favorites/guides/blog + 18 locale prefixes) — scripts/check-sitemap-
  # coverage.cjs fails the build when this list drifts. Netlify equivalent:
  # the /<prefix>/* /index.html 200 rules in _redirects section (5).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/(auto|business|construction|conversion|career|education|engineering|everyday|family|finance|fitness|food|health|homegarden|lifestyle|math|regional|science|tech|utilities|hub|compare|favorites|guides|blog|es|hi|ur|fr|de|pt|ar|ru|ja|zh|ko|it|nl|tr|id|vi|th|bn)(/|$)
  RewriteRule . /index.html [L]
  # Hard 404 catch-all: every other extensionless path is a TRUE 404 (the
  # ErrorDocument below serves the custom 404 page), never a 200 soft-404.
  # Netlify equivalent: the /* /404.html 404 rule last in _redirects.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

# Custom 404 page for the catch-all above (and any other Apache 404).
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://open.er-api.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
