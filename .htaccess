<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve existing files/dirs directly (never rewrite them)
  RewriteRule ^index\.html$ - [L]
  # Soft-404 fix: real asset requests (.js/.css/.png/...) that don't exist → Apache 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|svg|ico|xml|txt|json|webmanifest|woff2?)$
  RewriteRule . - [R=404,L]
  # Clean URL routes (extensionless) → SPA index.html with 200
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://open.er-api.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
